rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 3
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPairingCodeId(code) {
      return code is string
        && code.size() >= 6
        && code.size() <= 24
        && code.matches('^SOMA-[A-Z0-9]{4,12}$');
    }

    function isValidUserPublic(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'updatedAt'])
        && data.uid == userId
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.role in ['parent', 'teacher']
        && data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 64;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'parentPin', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phoneContact', 'parentPin', 'updatedAt'])
        && data.uid == userId
        && isValidId(data.uid)
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && (!('phoneContact' in data) || (data.phoneContact is string && data.phoneContact.size() <= 40))
        && data.parentPin is string && data.parentPin.matches('^[0-9]{4}$')
        && data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 64;
    }

    function isValidPairingSession(data) {
      return data.keys().hasAll([
          'pairingCode', 'childId', 'childName', 'grade', 'school',
          'deviceMode', 'parentPin', 'dailyCapMins', 'exchangeRateMins',
          'mandatorySubjects', 'requireParentApproval', 'availableScreenSeconds',
          'usedScreenTodayMins', 'learnedMinutesToday', 'isLocked', 'isPaired',
          'ownerUid', 'completedLessonIds', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'pairingCode', 'childId', 'childName', 'grade', 'school', 'classStream',
          'deviceMode', 'parentPin', 'dailyCapMins', 'exchangeRateMins',
          'mandatorySubjects', 'requireParentApproval', 'availableScreenSeconds',
          'usedScreenTodayMins', 'learnedMinutesToday', 'isLocked', 'isPaired',
          'ownerUid', 'completedLessonIds', 'updatedAt'
        ])
        && isValidPairingCodeId(data.pairingCode)
        && isValidId(data.childId)
        && data.childName is string && data.childName.size() >= 1 && data.childName.size() <= 80
        && data.grade is int && data.grade >= 1 && data.grade <= 12
        && data.school is string && data.school.size() >= 1 && data.school.size() <= 120
        && (!('classStream' in data) || (data.classStream is string && data.classStream.size() <= 120))
        && data.deviceMode in ['own_phone', 'hand_off']
        && data.parentPin is string && data.parentPin.matches('^[0-9]{4}$')
        && data.dailyCapMins is int && data.dailyCapMins >= 15 && data.dailyCapMins <= 300
        && data.exchangeRateMins is int && data.exchangeRateMins >= 5 && data.exchangeRateMins <= 60
        && data.mandatorySubjects is list && data.mandatorySubjects.size() <= 8
        && (data.mandatorySubjects.size() == 0 || data.mandatorySubjects[0] is string)
        && data.requireParentApproval is bool
        && data.availableScreenSeconds is int && data.availableScreenSeconds >= 0 && data.availableScreenSeconds <= 28800
        && data.usedScreenTodayMins is int && data.usedScreenTodayMins >= 0 && data.usedScreenTodayMins <= 600
        && data.learnedMinutesToday is int && data.learnedMinutesToday >= 0 && data.learnedMinutesToday <= 600
        && data.isLocked is bool
        && data.isPaired is bool
        && isValidId(data.ownerUid)
        && data.completedLessonIds is list && data.completedLessonIds.size() <= 50
        && (data.completedLessonIds.size() == 0 || data.completedLessonIds[0] is string)
        && data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 64;
    }

    function isLearnerSyncUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'isPaired',
        'deviceMode',
        'availableScreenSeconds',
        'usedScreenTodayMins',
        'learnedMinutesToday',
        'isLocked',
        'completedLessonIds',
        'updatedAt'
      ]);
    }

    function isParentSettingsUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'childName',
        'grade',
        'school',
        'classStream',
        'deviceMode',
        'parentPin',
        'dailyCapMins',
        'exchangeRateMins',
        'mandatorySubjects',
        'requireParentApproval',
        'availableScreenSeconds',
        'usedScreenTodayMins',
        'learnedMinutesToday',
        'isLocked',
        'isPaired',
        'completedLessonIds',
        'updatedAt'
      ]);
    }

    function isValidTeacherCodeId(code) {
      return code is string
        && code.size() >= 6
        && code.size() <= 24
        && code.matches('^TCH-[A-Z0-9]{4,12}$');
    }

    function isValidSchoolGradeId(key) {
      return key is string
        && key.size() >= 4
        && key.size() <= 128
        && key.matches('^g([1-9]|1[0-2])-[a-z0-9\\-]{2,110}$');
    }

    function isValidTeacherProfile(data) {
      return data.keys().hasAll([
          'teacherCode', 'fullName', 'school', 'teacherPin',
          'subjects', 'grade', 'classStream', 'ownerUid', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'teacherCode', 'fullName', 'school', 'tscNumber', 'teacherPin',
          'subjects', 'grade', 'classStream', 'ownerUid', 'updatedAt'
        ])
        && isValidTeacherCodeId(data.teacherCode)
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 80
        && data.school is string && data.school.size() >= 2 && data.school.size() <= 120
        && (!('tscNumber' in data) || (data.tscNumber is string && data.tscNumber.size() <= 40))
        && data.teacherPin is string && data.teacherPin.matches('^[0-9]{4}$')
        && data.subjects is list && data.subjects.size() >= 1 && data.subjects.size() <= 8
        && data.subjects[0] is string
        && data.grade is int && data.grade >= 1 && data.grade <= 12
        && data.classStream is string && data.classStream.size() >= 2 && data.classStream.size() <= 120
        && isValidId(data.ownerUid)
        && data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 64;
    }

    function isValidSchoolAssignments(data) {
      return data.keys().hasAll([
          'schoolGradeKey', 'school', 'grade', 'recentAssignments', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'schoolGradeKey', 'school', 'grade', 'recentAssignments', 'updatedAt'
        ])
        && isValidSchoolGradeId(data.schoolGradeKey)
        && data.school is string && data.school.size() >= 2 && data.school.size() <= 120
        && data.grade is int && data.grade >= 1 && data.grade <= 12
        && data.recentAssignments is list && data.recentAssignments.size() <= 12
        && (data.recentAssignments.size() == 0 || data.recentAssignments[0] is map)
        && data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 64;
    }

    match /test/connection {
      allow get: if true;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isVerifiedOwner(userId) && isValidUserPublic(incoming(), userId);
      allow update: if isValidId(userId) && isVerifiedOwner(userId)
        && isValidUserPublic(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'updatedAt']);
      allow delete: if false;

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isVerifiedOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId) && isValidId(docId) && isVerifiedOwner(userId)
          && isValidUserPrivate(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(docId) && isVerifiedOwner(userId)
          && isValidUserPrivate(incoming(), userId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phoneContact', 'parentPin', 'updatedAt']);
        allow delete: if false;
      }
    }

    match /pairings/{pairingCode} {
      // Prevent scraping or listing pairing codes; only single-document lookup by exact code
      allow list: if false;
      allow get: if isValidPairingCodeId(pairingCode);
      allow create: if isValidPairingCodeId(pairingCode)
        && isValidPairingSession(incoming())
        && incoming().pairingCode == pairingCode;
      allow update: if isValidPairingCodeId(pairingCode)
        && isValidPairingSession(incoming())
        && incoming().pairingCode == existing().pairingCode
        && incoming().childId == existing().childId
        && incoming().ownerUid == existing().ownerUid
        && (isLearnerSyncUpdate() || isParentSettingsUpdate());
      allow delete: if isValidPairingCodeId(pairingCode)
        && isSignedIn()
        && existing().ownerUid == request.auth.uid;
    }

    match /teachers/{teacherCode} {
      // Prevent listing/scraping teacher accounts; lookup only by exact Teacher Code
      allow list: if false;
      allow get: if isValidTeacherCodeId(teacherCode);
      allow create: if isValidTeacherCodeId(teacherCode)
        && isValidTeacherProfile(incoming())
        && incoming().teacherCode == teacherCode;
      allow update: if isValidTeacherCodeId(teacherCode)
        && isValidTeacherProfile(incoming())
        && incoming().teacherCode == existing().teacherCode
        && incoming().ownerUid == existing().ownerUid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName', 'school', 'tscNumber', 'teacherPin',
          'subjects', 'grade', 'classStream', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /school_assignments/{schoolGradeKey} {
      // Deterministic school+grade key prevents open collection listing
      allow list: if false;
      allow get: if isValidSchoolGradeId(schoolGradeKey);
      allow create: if isValidSchoolGradeId(schoolGradeKey)
        && isValidSchoolAssignments(incoming())
        && incoming().schoolGradeKey == schoolGradeKey;
      allow update: if isValidSchoolGradeId(schoolGradeKey)
        && isValidSchoolAssignments(incoming())
        && incoming().schoolGradeKey == existing().schoolGradeKey
        && incoming().grade == existing().grade
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'school', 'recentAssignments', 'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
